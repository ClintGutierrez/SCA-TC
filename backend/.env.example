# ====== CONFIGURACIÓN DEL PROYECTO ======

# ====== BACKEND - CONFIGURACIÓN DEL SERVIDOR ======
# Puerto en el que se ejecutará el servidor Node.js
BACKEND_PORT=5000

# Ambiente de ejecución (development, production, test)
NODE_ENV=development

# ====== DATABASE - CONFIGURACIÓN DE PostgreSQL ======
# Host del servidor PostgreSQL
DB_HOST=localhost

# Puerto del servidor PostgreSQL
DB_PORT=5432

# Nombre de la base de datos a utilizar
DB_NAME=inventario_bienes

# Usuario de PostgreSQL
DB_USER=postgres

# Contraseña del usuario PostgreSQL
DB_PASSWORD=postgres

# URL del frontend para CORS y cookies
FRONTEND_URL=http://localhost:5173

# Secreto fuerte para firmar JWT
JWT_SECRET=pon_aqui_un_secreto_largo_y_aleatorio

# Semilla de usuarios demo en desarrollo
SEED_DEFAULT_USERS=true

# ====== FRONTEND - CONFIGURACIÓN DEL CLIENTE ======
# URL del servidor backend (usada desde el navegador)
VITE_API_URL=http://localhost:5000

# ====== NOTAS DE CONFIGURACIÓN ======
# 1. Asegúrate de que PostgreSQL esté corriendo en tu máquina
# 2. Crea la base de datos antes de ejecutar las migraciones: createdb inventario_bienes
# 3. En producción, usa una contraseña fuerte y variables seguras
# 4. Nunca commits este archivo con datos sensibles - usa secrets en CI/CD
